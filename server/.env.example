PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/problempool?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here

# AI Service Configuration (Optional but recommended for Section 10)
# Google Gemini API key (Recommended: gemini-1.5-flash / gemini-2.0-flash)
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Alternatively, OpenAI API key
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

